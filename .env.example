# Mapbox (REQUIRED - pipeline fails without this)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Dashboard demo mode (used by dashboard/vercel.json and local demo runs)
NEXT_PUBLIC_W4W_DEMO_MODE=1
W4W_DASHBOARD_MODE=demo
NEXT_PUBLIC_W4W_TOOLING_REPO_URL=https://github.com/your-org/w4w-tooling

# OpenStreetMap API (only needed for osm_edit.py / apply_smoothness_batch.py)
OSM_CLIENT_ID=your_client_id_here
OSM_CLIENT_SECRET=your_client_secret_here
OSM_REDIRECT_URI=your_redirect_uri
OSM_SCOPES=write_api

# OSM API endpoints (defaults work for production)
OSM_BASE_URL=https://api.openstreetmap.org
OSM_OAUTH_AUTHORIZE_URL=https://www.openstreetmap.org/oauth2/authorize
OSM_OAUTH_TOKEN_URL=https://www.openstreetmap.org/oauth2/token
